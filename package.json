{
  "name": "pdfix-document-workspace",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "description": "A local Windows-first document workspace",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/sync-takeoff-model.mjs && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "npm run build && playwright test",
    "check": "npm test && npm run test:desktop",
    "package:windows": "npm run build && node scripts/build-windows-package.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@xmldom/xmldom": "0.8.15",
    "docx": "9.8.1",
    "dompurify": "3.4.17",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.9.3",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
